# ============================================================
# EARIST E-GatePass — Environment Variables (EXAMPLE)
# Copy this to .env.local and fill in real values.
# ============================================================

# Client-side (exposed to browser via Vite)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_USE_FIREBASE_EMULATORS=false

# Server-side ONLY (Netlify Functions — NEVER prefix with VITE_)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Firebase Admin SDK (for Netlify Functions only)
# Create a service account in Firebase Console > Project Settings > Service Accounts
# Handle escaped newlines: the init code replaces \\n with real newlines
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: authenticate scheduled image-purge requests.
CRON_SECRET=replace-with-a-long-random-secret
